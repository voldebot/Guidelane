.env.*.local

# Probe harness leftovers. `--keep-workspaces` deliberately leaves temp dirs on
# disk for debugging; they contain files a probe session wrote and must never be
# committed to a public repo.
tools/probe/.workspaces/
guidelane-probe-*/

# Filtered / free-tier probe runs. Only the full `--live` report is the
# conformance baseline; the .partial files are debugging output.
docs/research/*.partial.json
docs/research/*.partial.md
